# Environment Configuration for ANR College Website Backend
# Copy to .env and configure for your local environment

PROJECT_NAME="ANRCAS College API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Local SQLite for local zero-dependency testing:
DATABASE_URL="sqlite:///./anr_dev.db"
# Production PostgreSQL (Required when ENVIRONMENT=production):
# DATABASE_URL="postgresql://anr_admin:<STRONG_POSTGRES_PASSWORD>@db.internal:5432/anrcas_prod"

# Security & Authentication
# For development only:
SECRET_KEY="development_secret_key_change_in_production_anrcas_2026"
# In production, provide a high-entropy string of at least 32 characters generated via `openssl rand -hex 32`
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (Comma-separated origins allowed to access the API)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"
# Production example:
# ALLOWED_ORIGINS="https://anrcas.edu.in,https://www.anrcas.edu.in"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Storage / Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS="jpg,jpeg,png,webp"
